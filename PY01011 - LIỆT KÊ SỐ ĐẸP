def res(N) :
    a = []
    b = {'0','2','4','6','8'}
    for i in range(1,1000) : 
        s = str(i)
        if all(c in b for c in s) :
            p = int(s+s[::-1])
            if p < N :
                a.append(str(p))
    print(*a)

t = int(input()) 
for _ in range (t) :
    N= int(input()) 
    res(N)
