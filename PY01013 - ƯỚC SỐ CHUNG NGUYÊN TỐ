import math
def snt(n) :
    if n < 2 :
        return False 
    for i in range (2 , int(math.sqrt(n))+1) : 
        if n % i == 0 :
            return False 
    return True 



n = int(input()) 
for _ in range (n)  :
    a , b = list(map(int,input().split()))
    c = str(math.gcd(a,b)) 
    tong = 0
    for i in range(len(c)) : 
        tong += int(c[i])
    if snt(tong) :
        print("YES")
    else : 
        print("NO") 
