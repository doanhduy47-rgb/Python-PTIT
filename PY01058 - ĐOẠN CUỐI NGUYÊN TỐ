import math
t = int(input())

def snt(a) :
    if int(a) < 2 :
        return False 
    for i in range (2,int(math.sqrt(a))) :
        if a % i == 0 :
            return False 
    return True

for _ in range(t) :
    n = input() 
    s = int(n[-4:]) 
    if snt(s) :
        print("YES") 
    else :
        print("NO") 
