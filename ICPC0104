T = int(input())

for _ in range(T):
    s = input().strip()
    numbers = []
    temp = ""
    
    for ch in s:
        if ch.isdigit():
            temp += ch
        else:
            if temp != "":
                numbers.append(int(temp))
                temp = ""
    
    if temp != "":
        numbers.append(int(temp))
    
    print(min(numbers))
