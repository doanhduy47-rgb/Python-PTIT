import math
def snt(a) :
    if a < 2 :
        return False 
    for i in range(2,int(math.sqrt(a))+1) :
        if a % i == 0 :
            return False 
    return True 

n = int(input()) 
for _ in range(n) :
    t = input() 
    s = int(t[-4:])
    if snt(s) :
        print("YES") 
    else :
        print("NO")
